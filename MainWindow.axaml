<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:local="using:RomaToHiragana.Services"
                 xmlns:vm="using:RomaToHiragana.ViewModels"
                 xmlns:sys="using:System"
                 x:Class="RomaToHiragana.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="RomaToHiragana"
                 Width="780"
                 Height="600"
                 CanResize="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="12">

            <!-- 文件夹选择区 -->
            <TextBlock Text="选择包含目标文件的文件夹：" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox PlaceholderText="请选择文件夹路径"
                         MinWidth="580"
                         IsReadOnly="True"
                         Text="{Binding FolderPath, Mode=OneWay}" />
                <Button Content="浏览..."
                        MinWidth="80"
                        Click="OnBrowseClick" />
           </StackPanel>

            <!-- 操作按钮区（执行期间由命令的 CanExecute 自动禁用） -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="刷新文件列表"
                        MinWidth="130"
                        Command="{Binding RefreshCommand}" />
                <Button Content="开始批量转换并重命名"
                        MinWidth="180"
                        Command="{Binding RenameCommand}" />
           </StackPanel>

            <!-- 状态消息（FAUI 原生 FAInfoBar 控件） -->
            <ui:FAInfoBar IsClosable="True"
                          IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                          Severity="{Binding StatusSeverity}"
                          Title="{Binding StatusTitle}"
                          Message="{Binding StatusMessage}" />

            <!-- 文件列表区 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="转换预览（仅文件名主体部分会被转换，扩展名始终保持原样）："
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="全选"
                        MinWidth="56"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="全不选"
                        MinWidth="68"
                        Command="{Binding SelectNoneCommand}" />
           </StackPanel>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding Files}" MaxHeight="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:FileItem">
                            <Grid ColumnDefinitions="40,30,250,250,90" Margin="0,1">
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"
                                          Grid.Column="0"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Index}" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OriginalFileName}" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ConvertedFileName}" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusDisplay}" Grid.Column="4" VerticalAlignment="Center"/>
                           </Grid>
                       </DataTemplate>
                   </ListBox.ItemTemplate>
               </ListBox>
           </Border>

            <!-- 统计栏 -->
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="{Binding TotalCountDisplay}" />
                <TextBlock Text="{Binding PendingCountDisplay}" />
                <TextBlock Text="{Binding SkippedCountDisplay}" />
                <TextBlock Text="{Binding FailedCountDisplay}" Foreground="#CC3333" />
           </StackPanel>

            <!-- 操作日志 -->
            <TextBlock Text="操作日志：" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas, monospace"
                                           FontSize="12"
                                           Margin="4,1" />
                           </DataTemplate>
                       </ItemsControl.ItemTemplate>
                   </ItemsControl>
               </ScrollViewer>
           </Border>

            <TextBlock Text="提示：仅转换文件名主体（不含扩展名）；纯英文单词序列会自动保留，避免误改。"
                       FontSize="12"
                       Opacity="0.6" />
       </StackPanel>
   </ScrollViewer>
</wnd:FAAppWindow>
